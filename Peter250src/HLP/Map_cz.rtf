#{\footnote 20548}
#{\footnote 20549}
#{\footnote 20550}
${\footnote Plocha}
+{\footnote 1}
K{\footnote plocha;}
\pard \plain \brdrb \cf12 \fs24 \b
Plocha\par
\pard \plain \cf0 \fs20
{\uldb Stavební prvky programu}{\v Stavební prvky programu}\par
\par
