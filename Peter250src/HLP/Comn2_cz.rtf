\i offset 4: \i0 \tab počet vrcholů objektu\par
\i offset 8: \i0 \tab adresa paměťového bloku obsahujícího souřadnice vrcholů\par
\i offset 12: \i0 \tab adresa paměťového bloku obsahujícího normály\par
\i offset 16: \i0 \tab adresa paměťového bloku obsahujícího mapování textur (0=není)\par
\i offset 20: \i0 \tab adresa paměťového bloku obsahujícího barvy vrcholů (0=není)\par
\i offset 24: \i0 \tab počet plošek objektu\par
\i offset 28: \i0 \tab adresa paměťového bloku obsahujícího definice plošek\par
\par
