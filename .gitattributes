# Default line ending handling
* text=auto

# MSVC6 Source and Resource files
*.c       text eol=crlf
*.cpp     text eol=crlf
*.h       text eol=crlf
*.rc      text eol=crlf

# NOTE: .inc files I've specifically avoided touching. Most of them are
# fine with CP1250, but the internet/LLMs are suggesting at least one
# file wouldn't survive CP1250 -> UTF-8 in Git -> declared encoding
# conversion that would happen.
# ... and there's some CodePage / JazykInfo stuff that handles them at runtime.

# MSVC project files: keep CRLF line endings
*.dsp     text eol=crlf
*.dsw     text eol=crlf

*.txt     text
*.md      text
