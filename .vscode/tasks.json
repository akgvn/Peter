{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Loader (Wine)",
            "type": "process",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/build-loader-debug.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build Loader (Wine, VC6 symbols)",
            "type": "process",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/build-wine.ps1",
                "-Rebuild"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build Loader (Wine, LIEF)",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "--no-project",
                "${workspaceFolder}/scripts/rebuild-pdb-reference.py",
                "${workspaceFolder}/Peter250src/Loader/Debug/Peter.exe",
                "-o",
                "${workspaceFolder}/Peter250src/Loader/Debug/Peter-lief.exe"
            ],
            "dependsOn": "Build Loader (Wine, VC6 symbols)",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
